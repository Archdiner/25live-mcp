{"html": "<h1 class=\"margin-top-none\">\n    Booking Details\n</h1>\n\n<h2 class=\"sr-only\">\n    Booked Items</h2>\n\n\n    <p class=\"s-lc-session-info s-lc-setup-info\">\n        These times will be held for you until 2:10am Friday, October 23, 2026. If you do not complete your booking before that time, another patron may book these times.\n    </p>\n\n<div class=\"table-responsive\">\n    <table class=\"table s-lc-eq-checkouttb\">\n        \n<thead>\n<tr>\n    <th>\n        <span class=\"sr-only\">\n            Image        </span>\n    </th>\n            <th>\n            Item\n        </th>\n        <th>\n            Category\n        </th>\n        <th>\n        From\n    </th>\n    <th>\n        To\n    </th>\n        <th>\n        <span class=\"sr-only\">\n            Action        </span>\n    </th>\n</tr>\n</thead>\n\n<tbody>\n                                    \n                                                    \n        <tr id=\"eid_110724\">\n            <td>\n                            </td>\n            <td>\n                <strong>\n                    136 Table A\n                </strong>\n            </td>\n                                        <td>\n                    Catherwood Room Reservations\n                </td>\n                        <td>\n                                    5:00pm Monday, October 26, 2026\n                            </td>\n            <td>\n                                    7:00pm Monday, October 26, 2026\n                            </td>\n                        <td>\n                \n                                    <a href=\"#\" class=\"pull-right s-lc-booking-change-times\">\n                        Change\n                    </a>\n                            </td>\n        </tr>\n    \n    </tbody>\n    </table>\n</div>\n\n\n\n<div id=\"bform-form-container\" class=\"s-lc-booking-form\" >\n    <h2 class=\"sr-only\">\n        Booking Form    </h2>\n    <form class=\"form-horizontal\" name=\"s-lc-eq-bform\" id=\"s-lc-eq-bform\" method=\"post\" action=\"/ajax/space/book\" autocomplete=\"off\">\n        <div id=\"s-lc-bform-help\" class=\"s-lc-booking-form-help\" tabindex=\"-1\">\n            Fill out this form to complete the booking.\n        </div>\n\n        <input type=\"hidden\" id=\"session\" name=\"session\" value=\"101859629\">\n\n        \n\n\n\n\n\n\n\n\n\n    \n<div class=\"form-group s-lc-eq-q s-lc-eq-fname s-lc-eq-lname\">\n    <div class=\"col-sm-3 control-label s-lc-eq-flab\">\n        Full Name\n         *    </div>\n\n            <div class=\"col-sm-3\">\n            <label class=\"sr-only\" for=\"fname\">\n                First Name\n            </label>\n            <input type=\"text\"\n                   name=\"fname\"\n                   id=\"fname\"\n                   placeholder=\"First Name\"\n                   class=\"form-control notempty s-lc-patron-first-name\"\n                   required aria-required=\"true\"\n                   value=\"\"                   data-custom-required-msg=\"You&#x20;must&#x20;provide&#x20;a&#x20;name&#x21;\"\n                   autocomplete=\"given-name\">\n        </div>\n\n        <div class=\"col-sm-3\">\n            <label class=\"sr-only\" for=\"lname\">\n                Last Name\n            </label>\n            <input type=\"text\"\n                   name=\"lname\"\n                   id=\"lname\"\n                   placeholder=\"Last Name\"\n                   class=\"form-control notempty s-lc-patron-last-name\"\n                   required aria-required=\"true\"\n                   value=\"\"                   data-custom-required-msg=\"You&#x20;must&#x20;provide&#x20;a&#x20;name&#x21;\"\n                   autocomplete=\"family-name\">\n        </div>\n    </div>\n\n    <div class=\"form-group s-lc-eq-q s-lc-eq-email\">\n                    <label class=\"col-sm-3 control-label s-lc-eq-flab\" for=\"email\">\n                Email\n                 *            </label>\n            <div class=\"col-sm-6\">\n                <input\n                    type=\"email\"\n                    name=\"email\"\n                    id=\"email\"\n                    placeholder=\"\"\n                    class=\"form-control notempty s-lc-patron-email\"\n                    required aria-required=\"true\"                    value=\"\"\n                    data-custom-required-msg=\"You&#x20;must&#x20;provide&#x20;a&#x20;valid&#x20;email&#x20;address&#x21;\"\n                    autocomplete=\"email\">\n\n                                                        <p id=\"s-lc-rm-email-restrict\" class=\"help-block\">\n                                                    Enter @cornell.edu addresses only\n                                            </p>\n                \n                \n                <div id=\"s-lc-email-banned-alert\" class=\"alert alert-danger margin-top-med\" style=\"display: none;\">\n                    Email address is currently banned.                                        Please check the <a href=\"/admin/equipment/banned\" target=\"_blank\">Banned Users list</a> to see why this user is banned.                </div>\n            </div>\n            </div>\n\n\n\n\n\n\n\n\n            \n            \n        \n            \n\n        \n\n        \n\n        <div class=\"form-group \" id=\"btn-form-submit_container\">\n            <div class=\"col-md-offset-3 col-md-6\">\n    \n        <button class=\"btn btn-primary\" type=\"submit\" id=\"btn-form-submit\">\n            Submit my Booking\n        </button>\n\n        \n        \n            </div>\n    </div>\n    </form>\n</div>\n\n<script>\n    // this overrides a function in the base template to provide specific form validation for the selected items/categories/location\n    function customFormValidation() {\n            if (jQuery(\"#fname\").val().trim().length === 0) {\n        addError(\"is\\u0020required!\", \"fname\");\n        return false;\n    }\n\n    if (jQuery(\"#lname\").val().trim().length === 0) {\n        addError(\"is\\u0020required!\", \"lname\");\n        return false;\n    }\n\n    var email = jQuery(\"#email\").val().trim();\n\n    if (email.length === 0) {\n        addError(\"is\\u0020required!\", \"email\");\n        return false;\n    }\n\n    if (!validateEmailAddress(email)) {\n        addError(\"Not in a valid format!\", \"email\");\n        return false;\n    }\n\n            var emailIsValid = false;\n\n                    if (email.search(/@cornell.edu/i) !== -1) {\n                emailIsValid = true;\n            }\n        \n        if (!emailIsValid) {\n            addError('Your\\u0020email\\u0020address\\u0020must\\u0020end\\u0020with\\u0020one\\u0020of\\u0020these\\u0020domains\\u003A\\u0020\\u0040cornell.edu', 'email');\n            return false;\n        }\n    \n\n\n        return true;\n    }\n\n    springySession.setId(101859629);\n\n    jQuery('.s-lc-booking-change-times').on('click', function () {\n        springySession.end();\n\n        return true;\n    });\n\n    springySession.bindUnloadHandler();\n\n    jQuery('#s-lc-eq-terms').on('submit', agreeToTermsAndConditions);\n    jQuery('.s-lc-booking-change-times').on('click', changeBookingTimes);\n\n    \nfunction answerRuleShowHiddenQuestions() {\n    }\n\nfunction answerRuleShowHiddenText() {\n    }\n\nfunction answerRuleProcess() {\n            answerRuleShowHiddenQuestions();\n    answerRuleShowHiddenQuestions();\n\n    answerRuleShowHiddenText();\n}\n\njQuery('.s-lc-eq-q :input').on('change', answerRuleProcess);\n\n    \nvar fileDrop = new springSpace.sui.filedrop({\n    selector: \"#s-lc-eq-bform\",\n    max_files: 4,\n    max_upload_size: 20971520,\n    max_file_size: 20971520,\n    autoupload: false,\n    supportie9: false,\n    batch_files: false,\n    allowedMimeTypes: [],\n    allowedFileExtensions: [\"3ga\",\"3mf\",\"423\",\"7z\",\"acsm\",\"ai\",\"amr\",\"ashx\",\"bib\",\"bmp\",\"bst\",\"caj\",\"cda\",\"cfg\",\"ciw\",\"cls\",\"cp\",\"cptx\",\"csl\",\"css\",\"csv\",\"cxf\",\"dat\",\"db\",\"dbj\",\"dms\",\"do\",\"doc\",\"docm\",\"docx\",\"dot\",\"dotm\",\"dotx\",\"dps\",\"drf\",\"dta\",\"dwp\",\"egg\",\"elp\",\"eml\",\"enf\",\"enl\",\"enlx\",\"ens\",\"enw\",\"enz\",\"eot\",\"eps\",\"epub\",\"flp\",\"flv\",\"gcode\",\"gdoc\",\"gif\",\"gpx\",\"gz\",\"h5p\",\"har\",\"heic\",\"hwp\",\"icc\",\"ico\",\"ics\",\"idml\",\"indd\",\"ini\",\"intr\",\"isf\",\"iwb\",\"jfif\",\"jnlp\",\"jp2\",\"jpeg\",\"jpg\",\"js\",\"json\",\"kdh\",\"key\",\"kml\",\"kmz\",\"log\",\"m\",\"m3u\",\"m4a\",\"m4v\",\"map\",\"md\",\"mdb\",\"mgmf\",\"mgtx\",\"mht\",\"mkv\",\"mm\",\"mobi\",\"mov\",\"mp2\",\"mp3\",\"mp4\",\"mpeg\",\"mpg\",\"mrc\",\"mrk\",\"msg\",\"muse\",\"mvdx\",\"nbib\",\"odp\",\"ods\",\"odt\",\"oft\",\"ogg\",\"one\",\"opml\",\"otf\",\"ott\",\"oxps\",\"p\",\"pdf\",\"pdf-\",\"pdn\",\"pfl\",\"pl\",\"png\",\"por\",\"potx\",\"pps\",\"ppsm\",\"ppsx\",\"ppt\",\"pptm\",\"pptx\",\"prel\",\"ps\",\"psd\",\"psrv\",\"pub\",\"py\",\"qms\",\"quiz\",\"r\",\"r01\",\"ram\",\"rar\",\"ris\",\"rmd\",\"rtf\",\"rwb\",\"sas\",\"sav\",\"sb2\",\"silk\",\"sps\",\"spv\",\"stl\",\"sty\",\"svg\",\"swf\",\"tar\",\"taw\",\"tex\",\"tif\",\"tiff\",\"tsv\",\"ttf\",\"twb\",\"txt\",\"ubz\",\"url\",\"vcf\",\"vsd\",\"vsdx\",\"vstx\",\"vtt\",\"wav\",\"wcld\",\"webm\",\"webp\",\"wlmp\",\"wma\",\"wmf\",\"wmv\",\"woff\",\"wrf\",\"x3g\",\"xcf\",\"xls\",\"xlsb\",\"xlsm\",\"xlsx\",\"xlt\",\"xltx\",\"xml\",\"xps\",\"xsl\",\"xspf\",\"yml\",\"zip\"],\n    translations: {\n        max_file_size: \"Maximum\\u0020file\\u0020size\",\n        invalidExtension: \"File\\u0020is\\u0020not\\u0020an\\u0020allowed\\u0020file\\u0020type\\u003A\\u0020\",\n    },\n    error_callback: bookingErrorCallback,\n    callback: bookingSuccessCallback,\n    validate: preFormValidationAndPayload,\n});\n</script>\n"}